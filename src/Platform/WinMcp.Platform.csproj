<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WinMcp.Platform</RootNamespace>
    <AssemblyName>WinMCP</AssemblyName>
    <OutputType>Exe</OutputType>

    <!-- Platform versioning; bumped per release. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>WinMCP Platform</Product>
    <Company>WinMCP Project</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Warnings policy. Tighten over time, but don't WarningsAsErrors yet —
         we'll be churning a lot of files in P4. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModuleSdk\WinMcp.ModuleSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

</Project>
